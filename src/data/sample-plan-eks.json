      "risk_level": "HIGH",
      "blast_radius": "Kubernetes Compute Plane (Worker Nodes) & Pod Availability",
      "metrics": {
        "duration_ms": 46820,
        "prompt_tokens": 2340,
        "completion_tokens": 2110,
        "total_tokens": 4450
      },
      "summary": "The plan triggers a destructive replacement of the primary managed node group (aws_eks_node_group.app) due to an instance type change from t3.large to m6i.xlarge. All worker nodes in this group will be cordoned, drained, and terminated, requiring running pods to be rescheduled. In addition, worker security group rules are being updated.",
      "key_warnings": [
        "Replacement of aws_eks_node_group.app terminates all worker EC2 instances in us-east-1a and us-east-1b. Verify PodDisruptionBudgets (PDB) to avoid workload disruption.",
        "Ingress modifications on aws_security_group.nodes affect cross-node pod traffic; confirm VPC-CNI port allowances.",
        "CloudWatch log retention reduction on /aws/eks/prod/cluster will permanently truncate compliance audit trails."
      ],
      "resources": {
        "aws_eks_node_group.app": {
          "risk": "HIGH",
          "badge": "Node Group Replacement",
          "irreversible": true,
          "note": "Changing instance_types forces replacement of all underlying EC2 worker nodes. Pods without replica redundancy or PDBs will experience downtime."
        },
        "aws_security_group.nodes": {
          "risk": "MEDIUM",
          "badge": "Security Group Update",
          "irreversible": false,
          "note": "Modifies node-to-node ingress communication rules. Ensure core DNS and CNI health check ports remain accessible."
        },
        "aws_cloudwatch_log_group.eks": {
          "risk": "LOW",
          "badge": "Log Retention Update",
          "irreversible": false,
          "note": "Retention policy changed from 90 to 30 days. Older audit logs will expire sooner."
        }
      }
    }
  },
